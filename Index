<div class="composer"><label for="subject">Assunto</label><input id="subject" placeholder="Digite o assunto do e-mail"><label for="message">Mensagem inicial (opcional)</label><textarea id="message" placeholder="Olá,&#10;&#10;Segue para conhecimento..."></textarea><button class="success full" id="openOutlook">Abrir e-mail no Outlook</button><div class="copy-row"><button class="secondary" id="copyTo">Copiar Para</button><button class="secondary" id="copyCc">Copiar CC</button></div><button class="outline full" id="copyAll">Copiar todos os e-mails</button></div>
</aside></div>
</main>
