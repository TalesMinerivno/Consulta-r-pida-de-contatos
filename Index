<style>
/* 1. CORES PRINCIPAIS DA IDENTIDADE VISUAL */
:root{--dark:#14332D;--teal:#00998F;--teal-dark:#007d75;--mint:#dff3f0;--bg:#f4f5f4;--card:#ffffff;--text:#263330;--muted:#66736f;--line:#dfe5e3;--danger:#b74343;--shadow:0 4px 16px rgba(20,51,45,.08)}

/* 2. CONFIGURACOES GERAIS */
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text)}

/* 3. CABECALHO E LOGO */
header{background:#fff;border-bottom:5px solid var(--teal);padding:21px 30px;box-shadow:0 2px 10px rgba(20,51,45,.06)}.header-inner{max-width:1550px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:26px}.brand{display:flex;align-items:center;gap:28px}.brand-logo{width:180px;height:66px;object-fit:contain;object-position:left center}.brand-copy{padding-left:28px;border-left:1px solid var(--line)}.brand-copy h1{font-size:23px;color:var(--dark);margin:0 0 6px;font-weight:800;letter-spacing:-.35px}.brand-copy p{margin:0;color:var(--muted);font-size:14px}.badge{background:var(--dark);color:#fff;padding:10px 16px;font-size:12px;font-weight:700;letter-spacing:.4px}

/* 4. PAINEIS E FILTROS */
main{max-width:1550px;margin:22px auto;padding:0 22px 38px}.panel{background:var(--card);box-shadow:var(--shadow);padding:20px;margin-bottom:16px;border:1px solid var(--line)}.section-kicker{display:flex;align-items:center;gap:9px;margin-bottom:14px;color:var(--teal-dark);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.55px}.section-kicker:before{content:"";width:30px;height:4px;background:var(--teal)}
.search-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:12px}.field label{display:block;font-size:11px;font-weight:700;color:var(--dark);margin:0 0 7px;text-transform:uppercase;letter-spacing:.35px}.field input,.field select,.composer input,.composer textarea{width:100%;border:1px solid #cfd9d6;padding:0 12px;font:14px Arial;color:var(--text);background:#fff;outline:none}.field input,.field select,.composer input{height:42px}.field input:focus,.field select:focus,.composer input:focus,.composer textarea:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(0,153,143,.10)}
.actions,.selection-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:14px;flex-wrap:wrap}.btns{display:flex;gap:8px;flex-wrap:wrap}button{border:0;padding:10px 14px;font:700 12px Arial;cursor:pointer;transition:.16s}button:hover:not(:disabled){filter:brightness(.95);transform:translateY(-1px)}button:disabled{opacity:.45;cursor:not-allowed}.primary,.success{background:var(--teal);color:#fff}.secondary{background:#edf2f0;color:var(--dark)}.outline{background:#fff;color:var(--teal-dark);border:1px solid var(--teal)}.danger-lite{background:#f7eaea;color:var(--danger)}.status{color:var(--muted);font-size:13px}.status strong{color:var(--dark)}

/* 5. CARDS DE INDICADORES */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:16px}.kpi{position:relative;background:#fff;padding:16px 18px;box-shadow:var(--shadow);border:1px solid var(--line);border-top:4px solid var(--teal)}.kpi:nth-child(2){border-top-color:var(--dark)}.kpi:nth-child(3){border-top-color:#35aaa2}.kpi:nth-child(4){border-top-color:#7b8e89}.kpi span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;font-weight:700;letter-spacing:.45px}.kpi strong{font-size:25px;color:var(--dark);display:block;margin-top:5px}

/* 6. TABELA E PAINEL DO OUTLOOK */
.workspace{display:grid;grid-template-columns:minmax(0,1fr) 365px;gap:16px;align-items:start}.side{position:sticky;top:14px;border-top:5px solid var(--teal)}.side h2,.table-head h2{font-size:17px;color:var(--dark);margin:0}.hint{color:var(--muted);font-size:12px;line-height:1.45;margin:7px 0 14px}.bucket{border:1px solid var(--line);margin:10px 0;overflow:hidden}.bucket-title{display:flex;justify-content:space-between;background:var(--dark);color:#fff;padding:10px 12px;font-size:12px;font-weight:700}.chips{padding:8px;min-height:48px;max-height:150px;overflow:auto}.chip{display:flex;gap:7px;align-items:center;justify-content:space-between;padding:7px 8px;margin-bottom:5px;background:var(--mint);font-size:12px}.chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chip button{padding:1px 6px;background:transparent;color:var(--danger);font-size:16px}.composer{display:grid;gap:9px;margin-top:13px}.composer label{font-size:11px;font-weight:700;color:var(--dark);text-transform:uppercase}.composer textarea{height:84px;padding:10px 12px;resize:vertical;font-family:Arial}.full{width:100%}.copy-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.table-panel{padding:0;overflow:hidden}.table-head{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line);border-top:5px solid var(--dark)}.scroll{overflow:auto;max-height:68vh}table{width:100%;border-collapse:collapse;min-width:1220px}thead th{position:sticky;top:0;background:var(--dark);color:#fff;text-align:left;padding:11px 12px;font-size:11px;letter-spacing:.2px;z-index:2}tbody td{padding:10px 12px;border-bottom:1px solid #edf0ef;font-size:12px;vertical-align:middle}tbody tr:hover{background:#f2f8f7}tbody tr.selected{background:#e2f3f1}.sigla{display:inline-block;background:var(--mint);color:var(--teal-dark);font-weight:700;padding:4px 9px;white-space:nowrap}.cargo{font-weight:700;color:var(--dark)}.email a{color:var(--teal-dark);text-decoration:none}.empty{text-align:center;padding:45px;color:var(--muted)}.row-actions{display:flex;gap:5px}.mini{padding:6px 8px;font-size:10px;border:1px solid #b9cac6;background:#fff;color:var(--dark)}.mini.active-to{background:var(--teal);color:#fff}.mini.active-cc{background:var(--dark);color:#fff}.noemail{color:#98a39f;font-size:11px}.check{width:16px;height:16px;accent-color:var(--teal)}.toast{position:fixed;right:22px;bottom:22px;background:var(--dark);color:#fff;padding:12px 16px;box-shadow:var(--shadow);opacity:0;transform:translateY(12px);pointer-events:none;transition:.2s;z-index:20}.toast.show{opacity:1;transform:none}


/* 7. JANELA PARA ESCOLHER PARA OU CC */
.email-choice-overlay{position:fixed;inset:0;background:rgba(20,51,45,.55);display:none;align-items:center;justify-content:center;padding:20px;z-index:100}.email-choice-overlay.show{display:flex}.email-choice-modal{width:min(440px,100%);background:#fff;border-top:6px solid var(--teal);box-shadow:0 24px 70px rgba(0,0,0,.25);padding:24px}.email-choice-modal h3{margin:0 0 6px;color:var(--dark);font-size:20px}.email-choice-modal p{margin:0;color:var(--muted);font-size:13px;line-height:1.45}.choice-person{margin:16px 0;padding:13px;background:#f2f7f5;border-left:4px solid var(--dark)}.choice-person strong,.choice-person span{display:block}.choice-person span{margin-top:4px;color:var(--muted);font-size:12px}.choice-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.choice-btn{padding:15px 12px;font-size:13px}.choice-btn.to-choice{background:var(--teal);color:#fff}.choice-btn.cc-choice{background:var(--dark);color:#fff}.choice-cancel{width:100%;margin-top:10px;background:#edf2f0;color:var(--dark)}tbody tr[data-email="true"]{cursor:pointer}

