/* 2. NOMES DOS CAMPOS UTILIZADOS NA BASE */
const fields={g:'Gerência consolidada',c:'Coordenação / Área',s:'Sigla',f:'Cargo / Função',n:'Nome',m:'Matrícula',e:'E-mail',o:'Observação'};


/* 3. FUNCOES AUXILIARES DE BUSCA E SEGURANCA */
const $=id=>document.getElementById(id);const norm=v=>(v??'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();const esc=v=>(v??'').toString().replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]));


/* 4. CONTROLE DOS CONTATOS SELECIONADOS */
const key=r=>`${r[fields.m]}|${r[fields.e]}|${r[fields.n]}`;const recipients={to:new Map(),cc:new Map()};let marked=new Set();


/* 5. PREENCHIMENTO DOS FILTROS */
function uniques(k){return[...new Set(DATA.map(x=>x[k]).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'pt-BR'))}function fill(id,k){uniques(k).forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v;$(id).appendChild(o)})}fill('gerencia',fields.g);fill('sigla',fields.s);fill('cargo',fields.f);


/* 6. APLICACAO DOS FILTROS DE PESQUISA */
function filtered(){const q=norm($('search').value),g=$('gerencia').value,s=$('sigla').value,f=$('cargo').value;return DATA.filter(r=>(!q||Object.values(r).some(v=>norm(v).includes(q)))&&(!g||r[fields.g]===g)&&(!s||r[fields.s]===s)&&(!f||r[fields.f]===f))}


/* 7. ADICIONAR CONTATO EM PARA OU CC */
function addRecipient(type,k){const r=DATA.find(x=>key(x)===k);if(!r||!r[fields.e])return notify('Este contato não possui e-mail cadastrado.');const other=type==='to'?'cc':'to';recipients[other].delete(k);recipients[type].set(k,r);marked.add(k);render();renderRecipients()}
function removeRecipient(type,k){recipients[type].delete(k);if(!recipients.to.has(k)&&!recipients.cc.has(k))marked.delete(k);render();renderRecipients()}


/* 8. ATUALIZACAO DA TABELA E DOS INDICADORES */
function render(){const a=filtered(),b=$('body');$('kReg').textContent=a.length;$('kEmail').textContent=a.filter(r=>r[fields.e]).length;$('status').innerHTML=`Exibindo <strong>${a.length}</strong> de <strong>${DATA.length}</strong> registros`;$('checkAll').checked=a.length>0&&a.every(r=>marked.has(key(r)));
if(!a.length){b.innerHTML='<tr><td class="empty" colspan="9">Nenhum registro encontrado. Revise os filtros utilizados.</td></tr>';return}
b.innerHTML=a.map(r=>{const k=key(r),email=r[fields.e],isTo=recipients.to.has(k),isCc=recipients.cc.has(k);return`<tr data-k="${esc(k)}" data-email="${email?'true':'false'}" class="${marked.has(k)?'selected':''}"><td class="check-col"><input class="check rowcheck" type="checkbox" data-k="${esc(k)}" ${marked.has(k)?'checked':''} ${email?'':'disabled'}></td><td>${esc(r[fields.g])}</td><td>${esc(r[fields.c])}</td><td>${r[fields.s]?`<span class="sigla">${esc(r[fields.s])}</span>`:''}</td><td class="cargo">${esc(r[fields.f])}</td><td>${esc(r[fields.n])}</td><td>${esc(r[fields.m])}</td><td class="email">${email?`<a href="mailto:${esc(email)}">${esc(email)}</a>`:'<span class="noemail">Não cadastrado</span>'}</td><td><div class="row-actions">${email?`<button class="mini choose-email ${isTo?'active-to':isCc?'active-cc':''}" data-k="${esc(k)}">${isTo?'Em Para':isCc?'Em CC':'Escolher'}</button>`:'-'}</div></td></tr>`}).join('');
document.querySelectorAll('.choose-email').forEach(x=>x.onclick=e=>{e.stopPropagation();openChoice(x.dataset.k)});document.querySelectorAll('tbody tr[data-email="true"]').forEach(x=>x.onclick=e=>{if(e.target.closest('a,input,button'))return;openChoice(x.dataset.k)});document.querySelectorAll('.rowcheck').forEach(x=>x.onchange=()=>{const k=x.dataset.k;if(x.checked){openChoice(k);x.checked=false}else{recipients.to.delete(k);recipients.cc.delete(k);marked.delete(k);render();renderRecipients()}})}



/* 9. JANELA DE ESCOLHA ENTRE PARA E CC */
let choiceKey='';
function openChoice(k){const r=DATA.find(x=>key(x)===k);if(!r||!r[fields.e])return notify('Este contato não possui e-mail cadastrado.');choiceKey=k;$('choiceName').textContent=r[fields.n]||'Contato';$('choiceEmail').textContent=r[fields.e];$('emailChoice').classList.add('show')}
function closeChoice(){$('emailChoice').classList.remove('show');choiceKey=''}
$('choiceTo').onclick=()=>{if(choiceKey)addRecipient('to',choiceKey);closeChoice();notify('Contato adicionado em Para.')};
$('choiceCc').onclick=()=>{if(choiceKey)addRecipient('cc',choiceKey);closeChoice();notify('Contato adicionado em CC.')};
$('choiceCancel').onclick=closeChoice;$('emailChoice').onclick=e=>{if(e.target===$('emailChoice'))closeChoice()};document.addEventListener('keydown',e=>{if(e.key==='Escape')closeChoice()});


/* 10. ATUALIZACAO DO PAINEL DE DESTINATARIOS */
function renderRecipients(){for(const type of ['to','cc']){const box=$(type+'Chips'),items=[...recipients[type]];$(type+'Count').textContent=items.length;box.innerHTML=items.length?items.map(([k,r])=>`<div class="chip"><span title="${esc(r[fields.e])}">${esc(r[fields.n])}</span><button data-type="${type}" data-k="${esc(k)}" title="Remover">×</button></div>`).join(''):'<span class="noemail">Nenhum destinatário.</span>'}document.querySelectorAll('.chip button').forEach(x=>x.onclick=()=>removeRecipient(x.dataset.type,x.dataset.k));$('kTo').textContent=recipients.to.size;$('kCc').textContent=recipients.cc.size;$('openOutlook').disabled=recipients.to.size+recipients.cc.size===0}


/* 11. LISTAS DE E-MAILS, COPIA E AVISOS */
function emails(type){return[...recipients[type].values()].map(r=>r[fields.e]).filter(Boolean)}function notify(t){const x=$('toast');x.textContent=t;x.classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>x.classList.remove('show'),2200)}
async function copyText(text,label){if(!text)return notify('Nenhum e-mail selecionado.');try{await navigator.clipboard.writeText(text);notify(label+' copiado com sucesso.')}catch(e){const ta=document.createElement('textarea');ta.value=text;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();notify(label+' copiado com sucesso.')}}


/* 12. ABERTURA DA MENSAGEM NO OUTLOOK */
$('openOutlook').onclick=()=>{const to=emails('to'),cc=emails('cc'),params=new URLSearchParams();if(cc.length)params.set('cc',cc.join(';'));if($('subject').value)params.set('subject',$('subject').value);if($('message').value)params.set('body',$('message').value);window.location.href=`mailto:${to.join(';')}?${params.toString()}`};$('copyTo').onclick=()=>copyText(emails('to').join('; '),'Campo Para');$('copyCc').onclick=()=>copyText(emails('cc').join('; '),'Campo CC');$('copyAll').onclick=()=>copyText([...new Set([...emails('to'),...emails('cc')])].join('; '),'Lista de e-mails');


/* 13. BOTOES DE LIMPEZA, SELECAO E EXPORTACAO */
$('clearRecipients').onclick=()=>{recipients.to.clear();recipients.cc.clear();marked.clear();render();renderRecipients()};$('checkAll').onchange=e=>{filtered().filter(r=>r[fields.e]).forEach(r=>{const k=key(r);if(e.target.checked){marked.add(k);recipients.cc.delete(k);recipients.to.set(k,r)}else{marked.delete(k);recipients.to.delete(k);recipients.cc.delete(k)}});render();renderRecipients()};$('selectVisible').onclick=()=>{filtered().filter(r=>r[fields.e]).forEach(r=>{const k=key(r);marked.add(k);recipients.cc.delete(k);recipients.to.set(k,r)});render();renderRecipients();notify('Contatos visíveis adicionados em Para.')};
['search','gerencia','sigla','cargo'].forEach(id=>$(id).addEventListener(id==='search'?'input':'change',render));$('clear').onclick=()=>{$('search').value='';$('gerencia').value='';$('sigla').value='';$('cargo').value='';render();$('search').focus()};$('csv').onclick=()=>{const a=filtered(),hs=Object.values(fields),quote=v=>'"'+(v??'').toString().replace(/"/g,'""')+'"',csv='\ufeff'+[hs.map(quote).join(';'),...a.map(r=>hs.map(h=>quote(r[h])).join(';'))].join('\r\n'),blob=new Blob([csv],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download='consulta_organograma.csv';link.click();URL.revokeObjectURL(url)};


/* 14. INICIALIZACAO DO SISTEMA */
render();
renderRecipients();
</script></body></html>
